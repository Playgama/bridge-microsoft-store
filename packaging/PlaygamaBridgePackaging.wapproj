<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
  </PropertyGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>{B5E3A9C1-1A2B-4C3D-9E4F-000000000001}</ProjectGuid>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- The Store re-signs on upload; for local sideload, sign in the Create App Packages wizard. -->
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <EntryPointProjectUniqueName>..\PlaygamaBridgeMicrosoftStore.csproj</EntryPointProjectUniqueName>
  </PropertyGroup>
  <!-- Reuse the single source-of-truth manifest from the repo root. -->
  <ItemGroup>
    <AppxManifest Include="..\Package.appxmanifest">
      <Link>Package.appxmanifest</Link>
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <!-- The app (referenced below) copies Assets\ (logos + game) to its output, which this
       package includes, so the manifest's Assets\* logo paths resolve. -->
  <ItemGroup>
    <ProjectReference Include="..\PlaygamaBridgeMicrosoftStore.csproj" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>
